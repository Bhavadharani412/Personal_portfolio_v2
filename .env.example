# VITE_API_BASE: Public base URL of the Cloudflare Worker API (no trailing slash).
# Leave empty in local development so server.ts proxies /api/* requests.
# In Vercel Production/Preview, set to https://api.bhavadharani.me or your staging workers.dev URL.
VITE_API_BASE=

# GROQ_API_KEY: Required by the Cloudflare Worker for Groq AI inference.
# For local Wrangler development, put this in .dev.vars (gitignored).
# For Cloudflare production/staging, set via: npx wrangler secret put GROQ_API_KEY
GROQ_API_KEY="your_groq_api_key"

# ALLOWED_ORIGINS: Comma-separated list of allowed frontend origins for CORS & POST checks.
ALLOWED_ORIGINS="http://localhost:3000"
