# GROQ_API_KEY: Required by the Cloudflare Worker for Groq AI inference.
# Configure this as a server-side secret.
# Never expose this key to the browser or commit the real value to Git.
GROQ_API_KEY="your_groq_api_key"

# APP_URL: Public URL of the portfolio application.
# Used for allowed origins, API configuration, and production URL references.
APP_URL="https://your-domain.com"